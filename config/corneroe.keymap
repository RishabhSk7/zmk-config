#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {

        /*
         * Encoder rotation on the default layer:
         *   CW  -> Layer 1
         *   CCW -> Layer 2
         */
        encoder_layers: encoder_layers {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to 1>, <&to 2>;
        };

        /*
         * Encoder rotation on Layer 1:
         *   CW  -> Layer 0
         *   CCW -> Layer 2
         */
        encoder_layer1: encoder_layer1 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to 0>, <&to 2>;
        };

        /*
         * Encoder rotation on Layer 2:
         *   CW  -> Layer 1
         *   CCW -> Layer 0
         */
        encoder_layer2: encoder_layer2 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to 1>, <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =====================================================================
         * LAYER 0 - NORMAL / GAMING
         *
         * Left half:
         *
         * ESC   Q   W   E   R   T
         * TAB   A   S   D   F   G
         * SHIFT Z   X   C   V   B
         *
         * Thumb:
         * CTRL  ALT  SPACE
         *
         * Encoder:
         *   CW  -> Layer 1
         *   CCW -> Layer 2
         *   Press -> Windows
         * =================================================================== */

        default_layer {
            bindings = <
                &kp ESCAPE     &kp Q        &kp W        &kp E        &kp R        &kp T
                &kp Y         &kp U        &kp I        &kp O        &kp P        &kp BSPC
                &kp TAB       &kp A        &kp S        &kp D        &kp F        &kp G
                &kp H         &kp J        &kp K        &kp L        &kp SEMI     &kp RET
                &kp LSHFT     &kp Z        &kp X        &kp C        &kp V        &kp B
                &kp N         &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp SQT

                /* Left thumbs */
                &kp LEFT_CONTROL
                &kp LEFT_ALT
                &kp SPACE

                /* Right thumb / encoder positions */
                &mt LEFT_CONTROL SPACE
                &to 1
                &kp LEFT_CONTROL

                /* Encoder presses */
                &kp LGUI
                &kp RET
            >;

            sensor-bindings = <
                &encoder_layers
                &encoder_layers
            >;
        };


        /* =====================================================================
         * LAYER 1 - RGB / UNDERGLOW
         *
         * Encoder CW from Layer 0 enters this layer.
         *
         * Useful RGB controls on the LEFT HALF:
         *   Q = Toggle
         *   W = Brightness +
         *   E = Brightness -
         *   R = Effect +
         *   T = Effect -
         *   A = Hue +
         *   S = Hue -
         *   D = Saturation +
         *   F = Saturation -
         *   G = Effect speed +
         *   B = Effect speed -
         *
         * All other keys are transparent.
         * =================================================================== */

        lower_layer {
            bindings = <
                &rgb_ug RGB_TOG
                &rgb_ug RGB_BRI
                &rgb_ug RGB_BRD
                &rgb_ug RGB_EFF
                &rgb_ug RGB_EFR
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &rgb_ug RGB_HUI
                &rgb_ug RGB_HUD
                &rgb_ug RGB_SAI
                &rgb_ug RGB_SAD
                &rgb_ug RGB_SPI
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &trans
                &trans
                &trans
                &rgb_ug RGB_SPD
                &trans
                &rgb_ug RGB_EFF

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                /* Thumb positions */
                &trans
                &trans
                &trans

                /* Right thumb / encoder positions */
                &trans
                &to 2
                &trans

                /* Encoder presses */
                &kp LGUI
                &trans
            >;

            sensor-bindings = <
                &encoder_layer1
                &encoder_layer1
            >;
        };


        /* =====================================================================
         * LAYER 2 - RGB / UNDERGLOW
         *
         * Encoder CCW from Layer 0 enters this layer.
         *
         * Additional RGB controls, while preserving normal behavior through
         * transparent bindings.
         * =================================================================== */

        raise_layer {
            bindings = <
                &rgb_ug RGB_ON
                &rgb_ug RGB_OFF
                &rgb_ug RGB_TOG
                &rgb_ug RGB_EFF
                &rgb_ug RGB_EFR
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &rgb_ug RGB_HUI
                &rgb_ug RGB_HUD
                &rgb_ug RGB_BRI
                &rgb_ug RGB_BRD
                &rgb_ug RGB_SAI
                &rgb_ug RGB_SAD

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                &rgb_ug RGB_SPI
                &rgb_ug RGB_SPD
                &trans
                &trans
                &trans
                &trans

                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                /* Thumb positions */
                &trans
                &trans
                &trans

                /* Right thumb / encoder positions */
                &trans
                &to 1
                &trans

                /* Encoder presses */
                &kp LGUI
                &trans
            >;

            sensor-bindings = <
                &encoder_layer2
                &encoder_layer2
            >;
        };
    };
};
